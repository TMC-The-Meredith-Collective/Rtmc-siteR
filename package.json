{
  "name": "tmc-solutions-site",
  "private": true,
  "type": "module",
  "description": "tmcsolutions-org.net — static site + lead-intake API on one Cloudflare Worker",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test \"test/*.test.mjs\"",
    "check": "npm test && wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "csp:update": "node scripts/csp-update.mjs",
    "deploy": "npm run check && wrangler deploy"
  },
  "devDependencies": {
    "wrangler": "4.147.0"
  }
}
